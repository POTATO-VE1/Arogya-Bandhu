# ══════════════════════════════════════════════════════════════
# Aarogya Bandhu — Environment Variables
# Copy to .env and fill in values before running.
# ══════════════════════════════════════════════════════════════

# ── Database ──
# SQLite (dev):  sqlite:///./data/app.db
# PostgreSQL:    postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# ── Security (REQUIRED) ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_PASSWORD=

# ── Hospital ──
HOSPITAL_CODE=KA-DIST-01
HOSPITAL_NAME="District Hospital Demo"

# ── Twilio (optional — leave empty to use sim-only mode) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=1
PUBLIC_BASE_URL=

# ── Audio TTS (optional) ──
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── LLM Assist (optional — unset = template-only responses) ──
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ── Telegram Alerts (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STAFF_CODE=

# ── Demo Safety ──
# Comma-separated callable numbers in E.164 format.
# Calls to numbers outside this list are refused.
CALL_ALLOWLIST=

# ── Google Fit OAuth (optional — health device integration) ──
# Create at: https://console.cloud.google.com/apis/credentials
# Enable Fitness API: https://console.cloud.google.com/apis/library/fitness.googleapis.com
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# ── Health Encryption (optional) ──
# Fernet key for encrypting OAuth tokens at rest.
# Auto-generated if left empty (tokens won't survive restarts).
HEALTH_ENCRYPT_KEY=
