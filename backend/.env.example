# ══════════════════════════════════════════════════════════════
# Aarogya Bandhu — Environment Variables
# Copy to .env and fill in values before running.
#
# For free Railway / Render deploy, set these as environment
# variables in the dashboard (never commit the real .env).
# ══════════════════════════════════════════════════════════════

# ── Database ──
# SQLite (free, dev):  sqlite:///./data/app.db
# PostgreSQL (scale):   postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# ── Security (REQUIRED — app refuses to start in production without these) ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Per-hospital admin password (min 8 chars in production).
ADMIN_PASSWORD=

# ── Cross-hospital superadmin (one per deploy) ──
# The superadmin can log in, create hospitals, and see the cross-hospital
# dashboard. If SUPERADMIN_PASSWORD is empty, the superadmin is not seeded.
# Username defaults to "root"; min 12 chars in production.
SUPERADMIN_USERNAME=root
SUPERADMIN_PASSWORD=

# ── Hospital (the default hospital seeded on first start) ──
HOSPITAL_CODE=KA-DIST-01
HOSPITAL_NAME="District Hospital Demo"

# ── Twilio (optional — leave empty to use sim-only mode) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VALIDATE_SIGNATURE=1
# REQUIRED for Twilio webhooks (e.g. https://your-app.up.railway.app)
PUBLIC_BASE_URL=

# ── Audio TTS (optional) ──
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── LLM Assist (optional — unset = template-only responses) ──
# Single key. For free-tier rate-limit rotation, add more keys below.
GROQ_API_KEY=
# Additional Groq keys, comma-separated. All keys are round-robined, and
# any key that 429s is skipped for 60s before being retried. With N keys
# you get ~Nx the per-minute free-tier rate.
#   GROQ_API_KEYS=gsk_key2,gsk_key3,gsk_key4
GROQ_API_KEYS=
LLM_MODEL=llama-3.3-70b-versatile
#
# This repo's local .env ships with 2 additional keys for the demo.
# Real keys are NEVER committed — they live in your local .env (gitignored)
# or in Railway → Variables. The rotator code is in app/llm_rotator.py.

# ── Telegram Alerts (optional — same process, free, polling) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Staff access code for Telegram bot (required for /staff command to work)
TELEGRAM_STAFF_CODE=
# Admin's phone number (E.164 format) — only this user can create staff via
# the Telegram admin bot. Verified by sharing a Telegram contact.
# Example: +91XXXXXXXXXX (replace with a real phone; do not commit a real number)
ADMIN_PHONE_NUMBER=+91XXXXXXXXXX

# ── Demo Safety ──
# Legacy: comma-separated callable numbers in E.164 format (single account).
# Used as the allowlist of the implicit "default" account when TWILIO_ACCOUNTS
# is not set. Calls to numbers outside this list are refused (defence in
# depth on top of Twilio trial restrictions).
CALL_ALLOWLIST=

# ── Government API integrations (HMIS + ABDM) ──
#
# HMIS_SHARED_SECRET — used by the universal webhook + CSV upload.
# The hospital's IT computes HMAC-SHA256(secret, raw-body) and sends
# the hex digest in the X-HMIS-Signature header. Same secret for the
# webhook and the CSV upload form field.
#   Set a long random value for production:
#     python -c "import secrets; print(secrets.token_hex(32))"
HMIS_SHARED_SECRET=
#
# HMIS_INBOX_DIR — reserved for the SFTP-style file-drop poller (next
# iteration). The poller will scan this directory for new files and
# feed them through the same DischargeEvent pipeline.
HMIS_INBOX_DIR=
#
# ABDM_MODE — "mock" (default, in-process dict, no creds needed) or
# "real" (calls dev.abdm.gov.in sandbox / abdm.gov.in production).
# ABDM_BASE_URL — defaults to the ABDM sandbox at dev.abdm.gov.in.
# ABDM_CLIENT_ID, ABDM_CLIENT_SECRET — OAuth2 client_credentials.
# Get sandbox creds at https://sandbox.abdm.gov.in (free, no MoHFW
# approval for the sandbox; production needs MoHFW application).
ABDM_MODE=mock
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ── Multi-account Twilio rotation (optional) ──
# Each free Twilio account can verify at most 5 caller IDs. By configuring
# multiple accounts, you can dial more numbers. Each account in the list
# has its own per-account allowlist of up to 5 numbers. The rotator
# round-robins on success and skips accounts that 429 / 5xx.
# Format: JSON array of {name, sid, token, from, allowlist:[...]}.
#
# Example (2 accounts × 3 verified numbers = 6 diallable numbers total):
#   TWILIO_ACCOUNTS='[
#     {"name":"primary","sid":"ACxxx1","token":"...","from":"+15551111111",
#      "allowlist":["+919999900001","+919999900002","+919999900003"]},
#     {"name":"backup","sid":"ACxxx2","token":"...","from":"+15552222222",
#      "allowlist":["+919999900004","+919999900005","+919999900006"]}
#   ]'
# When set, this OVERRIDES the legacy TWILIO_ACCOUNT_SID/TOKEN/FROM_NUMBER.
# See app/ivr/twilio_rotator.py and FREE_DEPLOY.md §6.
TWILIO_ACCOUNTS=

# ── Login rate limiter ──
# 30 in dev (fast iteration); 900 (15 min) recommended in production.
# OWASP guidance is 15-minute lockout after 5 failures.
LOGIN_LOCK_SECONDS=30

# ── Google Fit OAuth (optional — health device integration) ──
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
# Fernet key for encrypting OAuth tokens at rest.
HEALTH_ENCRYPT_KEY=

# ── Escalation webhook (optional — hospital IT PagerDuty / Slack / WhatsApp) ──
# Body is JSON; signed with HMAC-SHA256(secret, body) → X-Signature header.
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_SECRET=

# ── Production Mode ──
# Set to "true" on deployment platforms (Railway, Render, etc.)
# Enables: HTTPS-only cookies, strict CORS, config validation at startup
# PRODUCTION=true
