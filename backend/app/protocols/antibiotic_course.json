{
  "id": "antibiotic_course",
  "version": 1,
  "name_en": "Infection discharged on antibiotics",
  "name_kn": "ಸೋಂಕು — ಯಾಂಟಿಬಯಾಟಿಕ್ ಕೋರ್ಸ್",
  "condition": "infection_abx",
  "schedule_days": [1, 3, 7],
  "start_node": "greet",
  "nodes": {
    "greet": { "type": "play", "clip": "greet", "next": "confirm_family" },
    "confirm_family": {
      "type": "question", "clip": "confirm_family", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_symptom_course" },
        "2": { "score": 0, "clip": "wrong_person", "next": "@end_noanswer" }
      }
    },
    "q_symptom_course": {
      "type": "question", "clip": "q_symptom_course", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_meds_today" },
        "2": { "score": 2, "clip": "counsel_yellow", "reason": "symptoms same as before", "next": "q_meds_today" },
        "3": { "score": 10, "clip": "red_response", "reason": "symptoms worsening", "next": "@end_red" }
      }
    },
    "q_meds_today": {
      "type": "question", "clip": "q_meds_today", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_pillcount_remaining" },
        "2": { "score": 2, "clip": "counsel_yellow", "reason": "doses missed today", "next": "q_pillcount_remaining" },
        "3": { "score": 6, "clip": "red_response", "reason": "meds stopped", "next": "@end_red" }
      }
    },
    "q_pillcount_remaining": {
      "type": "question", "clip": "q_pillcount_remaining", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "closing", "reason": "pill count: 0-3 remaining (adherent)" },
        "2": { "score": 2, "next": "closing", "reason": "pill count: 4-7 remaining (partial)" },
        "3": { "score": 6, "next": "closing", "reason": "pill count: 8+ remaining (adherence risk)" }
      }
    },
    "closing": { "type": "play", "clip": "closing", "next": "@end_ok" }
  },
  "sheet": {
    "bullets_kn": [
      "ವೈದ್ಯರು ಹೇಳಿದ ಔಷಧಿಯನ್ನು ಪೂರ್ತಿ ಕೋರ್ಸ್ ಮುಗಿಯುವವರೆಗೆ ಸಮಯಕ್ಕೆ ಕೊಡಿ.",
      "ಕಾಯಿಲೆ ಕಡಿಮೆಯಾದರೂ ಮಧ್ಯದಲ್ಲಿ ಔಷಧಿ ನಿಲ್ಲಿಸಬೇಡಿ.",
      "ಜ್ವರ ಹೆಚ್ಚಾದರೆ ಅಥವಾ ಉಸಿರಾಟ ತೊಂದರೆಯಾದರೆ ಆಸ್ಪತ್ರೆಗೆ ಬನ್ನಿ."
    ]
  }
}
