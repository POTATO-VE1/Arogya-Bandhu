{
  "id": "wound_care",
  "version": 1,
  "name_en": "Post-operative wound care",
  "name_kn": "ಶಸ್ತ್ರಚಿಕಿತ್ಸೆ ನಂತರದ ಗಾಯದ ಕಾಳಜಿ",
  "condition": "post_op",
  "schedule_days": [1, 3, 7, 14],
  "start_node": "greet",
  "nodes": {
    "greet": { "type": "play", "clip": "greet", "next": "confirm_family" },
    "confirm_family": {
      "type": "question", "clip": "confirm_family", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_wound" },
        "2": { "score": 0, "clip": "wrong_person", "next": "@end_noanswer" }
      }
    },
    "q_wound": {
      "type": "question", "clip": "q_wound", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_meds_today" },
        "2": { "score": 2, "clip": "counsel_yellow", "reason": "wound: pain/swelling reported", "next": "q_meds_today" },
        "3": { "score": 10, "clip": "red_response", "reason": "wound: pus/bleeding/fever (SSI red flag)", "next": "@end_red" }
      }
    },
    "q_meds_today": {
      "type": "question", "clip": "q_meds_today", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_pillcount" },
        "2": { "score": 2, "clip": "counsel_adherence", "reason": "doses missed today", "next": "q_pillcount" },
        "3": { "score": 6, "clip": "counsel_adherence", "reason": "meds stopped", "next": "q_pillcount" }
      }
    },
    "q_pillcount": {
      "type": "question", "clip": "q_pillcount", "retries": 1, "requires_antibiotic": true,
      "options": {
        "1": { "score": 0, "next": "edu_amr" },
        "2": { "score": 1, "reason": "pills remain: 4-7", "next": "edu_amr" },
        "3": { "score": 2, "reason": "pills remain: 8+", "next": "edu_amr" }
      }
    },
    "edu_amr": { "type": "play", "clip": "edu_amr", "next": "closing" },
    "closing": { "type": "play", "clip": "closing", "next": "@end_ok" }
  },
  "sheet": {
    "bullets_kn": [
      "ಗಾಯವನ್ನು ಒಣಗಿಟ್ಟಿರಿ, ಸ್ವಚ್ಛವಾಗಿ ಇಟ್ಟಿರಿ.",
      "ಕೈ ತೊಳೆದು ನಂತರ ಮಾತ್ರ ಗಾಯದ ಬಳಿ ಕೈ ಹಾಕಿ.",
      "ಔಷಧಿಯನ್ನು ಸಮಯಕ್ಕೆ, ಪೂರ್ತಿ ಕೋರ್ಸ್ ಮುಗಿಯುವವರೆಗೆ ಕೊಡಿ.",
      "ಹುಳು, ರಕ್ತಸ್ರಾವ, ಅಥವಾ ಜ್ವರ ಕಂಡರೆ ತಕ್ಷಣ ಆಸ್ಪತ್ರೆಗೆ ಬನ್ನಿ.",
      "ಯಾಂಟಿಬಯಾಟಿಕ್ ಗೋಳಿಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಬೇಡಿ, ಮುಂದಕ್ಕೆ ಇಡಬೇಡಿ."
    ]
  }
}