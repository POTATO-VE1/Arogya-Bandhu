{
  "id": "fever_viral",
  "version": 1,
  "name_en": "Fever / viral syndrome",
  "name_kn": "ಜ್ವರ / ಸೋಂಕು",
  "condition": "fever_viral",
  "schedule_days": [1, 3],
  "start_node": "greet",
  "nodes": {
    "greet": { "type": "play", "clip": "greet", "next": "confirm_family" },
    "confirm_family": {
      "type": "question", "clip": "confirm_family", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_fever" },
        "2": { "score": 0, "clip": "wrong_person", "next": "@end_noanswer" }
      }
    },
    "q_fever": {
      "type": "question", "clip": "q_fever", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "q_breath" },
        "2": { "score": 2, "clip": "counsel_yellow", "reason": "mild fever", "next": "q_breath" },
        "3": { "score": 10, "clip": "red_response", "reason": "high fever with rigors", "next": "@end_red" }
      }
    },
    "q_breath": {
      "type": "question", "clip": "q_breath", "retries": 1,
      "options": {
        "1": { "score": 0, "next": "closing" },
        "2": { "score": 10, "clip": "red_response", "reason": "breathlessness", "next": "@end_red" }
      }
    },
    "closing": { "type": "play", "clip": "closing", "next": "@end_ok" }
  },
  "sheet": {
    "bullets_kn": [
      "ಧಾರಾಳ ನೀರು ಕುಡಿಯಿರಿ, ವಿಶ್ರಾಂತಿ ತಗೊಳ್ಳಿ.",
      "ಜ್ವರ ಬಂದಾಗ ಪ್ಯಾರಾಸಿಟಮಾಲ್ ತಗೊಳ್ಳಬಹುದು, ಆದರೆ ವೈದ್ಯರ ಸಲಹೆಯಿಲ್ಲದೆ ಔಷಧಿ ತಗೊಳ್ಳಬೇಡಿ.",
      "ಉಸಿರಾಟ ತೊಂದರೆ ಅಥವಾ ಜ್ವರ ೩ ದಿನ ಮೀರಿದರೆ ಆಸ್ಪತ್ರೆಗೆ ಬನ್ನಿ."
    ]
  }
}
